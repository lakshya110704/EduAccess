# Copy to .env and fill in. Never commit .env.

# Generate with: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Full origins (scheme + host) that may POST forms, e.g. https://eduaccess.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=
# Only needed if a frontend on another origin calls the API
DJANGO_CORS_ALLOWED_ORIGINS=
DJANGO_TIME_ZONE=Asia/Kolkata
DJANGO_LOG_LEVEL=INFO

# postgresql (default) or sqlite (local experiments only)
DB_ENGINE=postgresql
DB_NAME=eduaccess
DB_USER=eduaccess
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
