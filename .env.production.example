# Production .env for docker-compose.yml. Copy to .env on the server and fill in; never commit it.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-host.example.ts.net
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-host.example.ts.net
DJANGO_TIME_ZONE=Asia/Kolkata
DJANGO_LOG_LEVEL=INFO

DB_NAME=eduaccess
DB_USER=eduaccess
DB_PASSWORD=

# Self sign-up: email domain required for each role
SIGNUP_STUDENT_EMAIL_DOMAIN=muj.manipal.edu
SIGNUP_PROFESSOR_EMAIL_DOMAIN=jaipur.manipal.edu
